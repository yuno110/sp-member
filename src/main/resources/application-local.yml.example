# 로컬 개발 전용 설정 템플릿
#
# 사용법: 이 파일을 application-local.yml 로 복사하고 비밀번호를 채운다.
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#
# application-local.yml 은 .gitignore 에 있어 커밋되지 않는다.
# application.yml 의 값을 덮어쓰므로 여기 적은 password 가 이긴다.

spring:
  datasource:
    password: 여기에_MySQL_root_비밀번호

  # 로컬 프로파일만 SQL 로그를 켠다 (sp-docs/conventions.md §8)
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    org.hibernate.orm.jdbc.bind: trace

# 서비스 간 내부 API 인증 키. member 와 board 가 같은 값을 써야 한다
# (sp-docs/security.md §6)
member-service:
  internal-api-key: 여기에_내부_API_키

# CORS 허용 오리진. 허용 오리진은 환경이 정하므로 정본에 목록이 없다
# (sp-docs/security.md §1.1). * 는 쓸 수 없다 — 기동이 실패한다.
# 여러 개는 쉼표로 구분한다
cors:
  allowed-origins: http://localhost:3000

# 요청 수 제한의 한도를 크게 덮는다 (sp-docs/tech-stack.md §4.6). 실제 서비스 e2e 는 local 로
# 띄운 서비스를 한 주소에서 여러 번 치므로 운영 한도(분당 20, application.yml)로는 e2e 가 스스로
# 429 를 맞는다. 값은 이 템플릿이 정하고 기준은 「운영 한도보다 e2e 의 요청 수가 넉넉히 들어가게」
# 다. 이 덮음 때문에 e2e 는 제한을 검증하지 않는다 — 제한은 서비스의 테스트가 시계를 움직여 본다.
# 창(window)과 버킷 수는 application.yml 의 값이 그대로 쓰인다 — 두 파일은 키 단위로 합쳐진다
rate-limit:
  rules:
    check-nickname:
      limit: 10000
